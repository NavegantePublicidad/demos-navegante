# ── Servidor ─────────────────────────────────────────────────────────────
PORT=8080
DB_PATH=./data/demos.sqlite
TZ=America/Monterrey
# Token para llamar a /cron/* a mano (curl -H "Authorization: Bearer ...")
CRON_TOKEN=cambia-esto

# ── Meta WhatsApp Cloud API (app de Facebook, número de prueba) ──────────
# developers.facebook.com → tu app → WhatsApp → API Setup
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Lo inventas tú y lo pegas igual en la configuración del webhook
META_VERIFY_TOKEN=navegante-demos
META_GRAPH_VERSION=v21.0
# Opcional: plantilla aprobada para mensajes fuera de la ventana de 24 h (reporte 8 AM, recordatorios)
META_TEMPLATE_REPORTE=
META_TEMPLATE_RECORDATORIO=

# ── Telegram (lado del dueño / asesora) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=cambia-esto
# chat_id del dueño (te lo dice el bot cuando le escribes /id)
TELEGRAM_CHAT_ID_DUENO=

# ── Dueño en WhatsApp (recibe el reporte de las 8 AM). Formato 521XXXXXXXXXX ──
OWNER_WHATSAPP=

# ── Anthropic ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# Tope de llamadas a Claude por día (seguro anti-sorpresas)
CLAUDE_TOPE_DIARIO=300

# ── Google (cuenta de servicio) ──────────────────────────────────────────
# JSON completo de la cuenta de servicio, en una sola línea, o en base64
GOOGLE_SERVICE_ACCOUNT_JSON=
# ID de la hoja (lo de la URL entre /d/ y /edit). Pestañas: Gastos, Leads, Ventas, Pendientes
GOOGLE_SHEET_ID=
# ID del calendario (Configuración del calendario → "ID del calendario"), compartido con la cuenta de servicio con permiso de editar
GOOGLE_CALENDAR_ID=

# ── Negocio de demo ──────────────────────────────────────────────────────
NEGOCIO_NOMBRE=Navegante Demo
DUENO_NOMBRE=Luis
ASESORA_NOMBRE=Frida
